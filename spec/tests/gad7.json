{
  "id": "gad7",
  "name": "GAD-7",
  "title_ko": "범불안 증상 7문항",
  "measures": "불안과 걱정 관련 증상의 빈도",
  "recall": "지난 2주",
  "korean_form_status": "form_available",
  "sources": [
