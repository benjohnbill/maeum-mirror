    "S06-03",
    "S06-07"
  ],
  "instruction": "지난 2 주 동안 당신은 다음의 문제들로 인해서 얼마나 자주 방해를 받았습니까?",
  "options": [
    {
      "value": 0,
      "label": "전혀 방해 받지 않았다"
    },
    {
      "value": 1,
      "label": "며칠 동안 방해 받았다"
    },
    {
      "value": 2,
      "label": "2 주 중 절반 이상 방해 받았다"
    },
    {
      "value": 3,
      "label": "거의 매일 방해 받았다"
    }
  ],
  "items": [
    {
      "id": "gad7.1",
      "text": "초조하거나 불안하거나 조마조마하게 느낀다",
      "cue": "긴장·초조"
    },
    {
      "id": "gad7.2",
      "text": "걱정하는 것을 멈추거나 조절할 수가 없다",
      "cue": "걱정 조절 곤란"
    },
    {
      "id": "gad7.3",
      "text": "여러 가지 것들에 대해 걱정을 너무 많이 한다",
      "cue": "과도한 걱정"
    },
    {
      "id": "gad7.4",
      "text": "편하게 있기가 어렵다",
      "cue": "긴장 풀기 어려움"
    },
    {
      "id": "gad7.5",
      "text": "너무 안절부절못해서 가만히 있기가 힘들다",
      "cue": "가만있지 못함"
    },
    {
      "id": "gad7.6",
      "text": "쉽게 짜증이 나거나 쉽게 성을 내게 된다",
      "cue": "짜증·화가 잦음"
    },
    {
      "id": "gad7.7",
      "text": "마치 끔찍한 일이 생길 것처럼 두렵게 느껴진다",
      "cue": "불길한 두려움"
    }
  ],
